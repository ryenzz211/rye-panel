<%- include('../partials/header.ejs', { user: user }) %>

<div class="system-container">
  <div class="system-header">
    <h2><i class="fas fa-server"></i> System Info</h2>
    <p>Informasi sistem dan resource panel</p>
  </div>

  <!-- CHARTS SECTION -->
  <div class="charts-grid">
    <div class="chart-card">
      <h3><i class="fas fa-microchip"></i> CPU Usage</h3>
      <canvas id="cpuChart" height="150"></canvas>
      <div class="chart-stats">
        <span>Load 1min: <strong id="load1">0.00</strong></span>
        <span>Load 5min: <strong id="load5">0.00</strong></span>
        <span>Load 15min: <strong id="load15">0.00</strong></span>
      </div>
    </div>

    <div class="chart-card">
      <h3><i class="fas fa-memory"></i> Memory Usage</h3>
      <canvas id="memoryChart" height="150"></canvas>
      <div class="chart-stats">
        <span>Used: <strong id="memUsed">0 MB</strong></span>
        <span>Free: <strong id="memFree">0 MB</strong></span>
        <span>Total: <strong id="memTotal">0 MB</strong></span>
      </div>
    </div>

    <div class="chart-card">
      <h3><i class="fas fa-hdd"></i> Storage Usage</h3>
      <canvas id="storageChart" height="150"></canvas>
      <div class="chart-stats">
        <span>Used: <strong id="storageUsed">0 MB</strong></span>
        <span>Free: <strong id="storageFree">0 MB</strong></span>
        <span>Total: <strong id="storageTotal">0 GB</strong></span>
      </div>
    </div>
  </div>

  <!-- INFO CARDS -->
  <div id="systemInfo" class="system-grid">
    <div class="loading">Loading system info...</div>
  </div>
</div>

<%- include('../partials/sidebar.ejs', { user: user, currentPath: currentPath }) %>

<style>
  .system-container {
    padding: 20px;
    max-width: 1400px;
    margin: 60px auto 0 0;
  }

  .system-header {
    margin-bottom: 25px;
  }

  .system-header h2 {
    font-size: 1.5rem;
    margin: 0;
  }

  .system-header h2 i {
    color: #6c63ff;
  }

  .system-header p {
    color: var(--text-secondary, #888);
    margin: 5px 0 0;
  }

  /* CHARTS */
  .charts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-bottom: 30px;
  }

  .chart-card {
    background: var(--bg-card, rgba(255,255,255,0.04));
    border-radius: 16px;
    padding: 20px;
    border: 1px solid var(--border-color, rgba(255,255,255,0.06));
  }

  .chart-card h3 {
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0 0 12px 0;
    color: var(--text-color, #ddd);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .chart-card h3 i {
    color: #6c63ff;
  }

  .chart-card canvas {
    width: 100% !important;
    max-height: 150px;
  }

  .chart-stats {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    font-size: 0.75rem;
    color: var(--text-secondary, #888);
    flex-wrap: wrap;
    gap: 8px;
  }

  .chart-stats strong {
    color: var(--text-color, #fff);
  }

  /* SYSTEM GRID */
  .system-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .system-card {
    background: var(--bg-card, rgba(255,255,255,0.04));
    border-radius: 16px;
    padding: 18px 20px;
    border: 1px solid var(--border-color, rgba(255,255,255,0.06));
  }

  .system-card h3 {
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0 0 12px 0;
    color: var(--text-secondary, #aaa);
    border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.06));
    padding-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .system-card h3 i {
    color: #6c63ff;
  }

  .system-card .info-row {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    font-size: 0.85rem;
  }

  .system-card .info-row .label {
    color: var(--text-secondary, #888);
  }

  .system-card .info-row .value {
    color: var(--text-color, #ddd);
    font-weight: 500;
  }

  .system-card .info-row .value.highlight { color: #6c63ff; }
  .system-card .info-row .value.success { color: #22c55e; }
  .system-card .info-row .value.warning { color: #f59e0b; }
  .system-card .info-row .value.danger { color: #ef4444; }

  .loading {
    text-align: center;
    padding: 40px;
    color: var(--text-secondary, #888);
    grid-column: 1 / -1;
  }

  @media (min-width: 1024px) {
    .system-container { margin-left: 0; }
  }

  @media (max-width: 768px) {
    .system-container { padding: 10px; margin: 60px 10px 0; }
    .charts-grid { grid-template-columns: 1fr; }
    .system-grid { grid-template-columns: 1fr; }
    .chart-stats { font-size: 0.65rem; }
  }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
  let cpuChart, memoryChart, storageChart;
  let chartData = { cpu: [], memory: [], storage: [] };

  // ============ INIT CHARTS ============
  function initCharts() {
    const ctx1 = document.getElementById('cpuChart').getContext('2d');
    const ctx2 = document.getElementById('memoryChart').getContext('2d');
    const ctx3 = document.getElementById('storageChart').getContext('2d');

    const chartOptions = {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false }
      },
      scales: {
        y: {
          beginAtZero: true,
          max: 100,
          grid: { color: 'rgba(255,255,255,0.05)' },
          ticks: { color: '#666', font: { size: 10 } }
        },
        x: {
          grid: { display: false },
          ticks: { display: false }
        }
      },
      animation: {
        duration: 500
      }
    };

    const colors = {
      cpu: { border: '#6c63ff', bg: 'rgba(108,99,255,0.1)' },
      memory: { border: '#22c55e', bg: 'rgba(34,197,94,0.1)' },
      storage: { border: '#f59e0b', bg: 'rgba(245,158,11,0.1)' }
    };

    cpuChart = new Chart(ctx1, {
      type: 'line',
      data: {
        labels: Array(20).fill(''),
        datasets: [{
          data: Array(20).fill(0),
          borderColor: colors.cpu.border,
          backgroundColor: colors.cpu.bg,
          borderWidth: 2,
          fill: true,
          tension: 0.3,
          pointRadius: 0
        }]
      },
      options: { ...chartOptions, plugins: { legend: { display: false } } }
    });

    memoryChart = new Chart(ctx2, {
      type: 'line',
      data: {
        labels: Array(20).fill(''),
        datasets: [{
          data: Array(20).fill(0),
          borderColor: colors.memory.border,
          backgroundColor: colors.memory.bg,
          borderWidth: 2,
          fill: true,
          tension: 0.3,
          pointRadius: 0
        }]
      },
      options: { ...chartOptions, plugins: { legend: { display: false } } }
    });

    storageChart = new Chart(ctx3, {
      type: 'line',
      data: {
        labels: Array(20).fill(''),
        datasets: [{
          data: Array(20).fill(0),
          borderColor: colors.storage.border,
          backgroundColor: colors.storage.bg,
          borderWidth: 2,
          fill: true,
          tension: 0.3,
          pointRadius: 0
        }]
      },
      options: { ...chartOptions, plugins: { legend: { display: false } } }
    });
  }

  // ============ UPDATE CHART DATA ============
  function updateChart(chart, value, maxHistory = 20) {
    const data = chart.data.datasets[0].data;
    data.push(value);
    if (data.length > maxHistory) data.shift();
    chart.update('none');
  }

  // ============ LOAD SYSTEM INFO ============
  async function loadSystemInfo() {
    try {
      const res = await fetch('/api/system/info');
      const data = await res.json();

      const container = document.getElementById('systemInfo');

      if (!data.success) {
        container.innerHTML = `<div class="empty-state" style="color:#ef4444;">Error: ${data.message}</div>`;
        return;
      }

      const info = data.data;

      // ===== UPDATE CHARTS =====
      const memPercent = parseFloat(info.memory.usagePercent);
      const storagePercent = parseFloat(info.storage.usagePercent);
      const loadAvg = parseFloat(info.cpu.loadAverage['1min']) || 0;
      const cpuPercent = Math.min(loadAvg / info.cpu.cores * 100, 100);

      updateChart(cpuChart, cpuPercent);
      updateChart(memoryChart, memPercent);
      updateChart(storageChart, storagePercent);

      // ===== UPDATE CHART STATS =====
      document.getElementById('load1').textContent = info.cpu.loadAverage['1min'];
      document.getElementById('load5').textContent = info.cpu.loadAverage['5min'];
      document.getElementById('load15').textContent = info.cpu.loadAverage['15min'];

      document.getElementById('memUsed').textContent = info.memory.used;
      document.getElementById('memFree').textContent = info.memory.free;
      document.getElementById('memTotal').textContent = info.memory.total;

      document.getElementById('storageUsed').textContent = info.storage.used;
      document.getElementById('storageFree').textContent = info.storage.free;
      document.getElementById('storageTotal').textContent = info.storage.total;

      // ===== UPDATE INFO CARDS =====
      const memColor = memPercent > 85 ? 'danger' : memPercent > 70 ? 'warning' : 'success';
      const storageColor = storagePercent > 80 ? 'danger' : storagePercent > 60 ? 'warning' : 'success';

      const html = `
        <!-- OS -->
        <div class="system-card">
          <h3><i class="fas fa-desktop"></i> OS</h3>
          <div class="info-row"><span class="label">Platform</span><span class="value">${info.os.platform}</span></div>
          <div class="info-row"><span class="label">Architecture</span><span class="value">${info.os.arch}</span></div>
          <div class="info-row"><span class="label">Release</span><span class="value">${info.os.release}</span></div>
          <div class="info-row"><span class="label">Hostname</span><span class="value">${info.os.hostname}</span></div>
          <div class="info-row"><span class="label">Uptime</span><span class="value highlight">${info.os.uptime}</span></div>
        </div>

        <!-- CPU -->
        <div class="system-card">
          <h3><i class="fas fa-microchip"></i> CPU</h3>
          <div class="info-row"><span class="label">Model</span><span class="value" style="font-size:0.75rem;">${info.cpu.model}</span></div>
          <div class="info-row"><span class="label">Cores</span><span class="value">${info.cpu.cores}</span></div>
          <div class="info-row"><span class="label">Load 1min</span><span class="value">${info.cpu.loadAverage['1min']}</span></div>
          <div class="info-row"><span class="label">Load 5min</span><span class="value">${info.cpu.loadAverage['5min']}</span></div>
          <div class="info-row"><span class="label">Load 15min</span><span class="value">${info.cpu.loadAverage['15min']}</span></div>
        </div>

        <!-- Memory -->
        <div class="system-card">
          <h3><i class="fas fa-memory"></i> Memory</h3>
          <div class="info-row"><span class="label">Total</span><span class="value">${info.memory.total}</span></div>
          <div class="info-row"><span class="label">Used</span><span class="value ${memColor}">${info.memory.used}</span></div>
          <div class="info-row"><span class="label">Free</span><span class="value">${info.memory.free}</span></div>
          <div class="info-row"><span class="label">Usage</span><span class="value ${memColor}">${info.memory.usagePercent}</span></div>
        </div>

        <!-- Storage -->
        <div class="system-card">
          <h3><i class="fas fa-hdd"></i> Storage</h3>
          <div class="info-row"><span class="label">Total</span><span class="value">${info.storage.total}</span></div>
          <div class="info-row"><span class="label">Used</span><span class="value ${storageColor}">${info.storage.used}</span></div>
          <div class="info-row"><span class="label">Free</span><span class="value">${info.storage.free}</span></div>
          <div class="info-row"><span class="label">Usage</span><span class="value ${storageColor}">${info.storage.usagePercent}</span></div>
        </div>

        <!-- Network -->
        <div class="system-card">
          <h3><i class="fas fa-network-wired"></i> Network</h3>
          <div class="info-row"><span class="label">IP Address</span><span class="value highlight">${info.network.ip}</span></div>
        </div>

        <!-- Node.js -->
        <div class="system-card">
          <h3><i class="fab fa-node-js"></i> Node.js</h3>
          <div class="info-row"><span class="label">Version</span><span class="value">${info.node.version}</span></div>
          <div class="info-row"><span class="label">Environment</span><span class="value">${info.node.env}</span></div>
          <div class="info-row"><span class="label">PID</span><span class="value">${info.node.pid}</span></div>
        </div>

        <!-- Bots -->
        <div class="system-card">
          <h3><i class="fas fa-robot"></i> Bots</h3>
          <div class="info-row"><span class="label">Total Bots</span><span class="value">${info.bots.total}</span></div>
          <div class="info-row"><span class="label">Running</span><span class="value success">${info.bots.running}</span></div>
          <div class="info-row"><span class="label">Stopped</span><span class="value">${info.bots.stopped}</span></div>
          <div class="info-row"><span class="label">Error</span><span class="value danger">${info.bots.error}</span></div>
          <div class="info-row"><span class="label">Processes</span><span class="value">${info.bots.processes}</span></div>
        </div>
      `;

      container.innerHTML = html;
    } catch (error) {
      document.getElementById('systemInfo').innerHTML = `
        <div class="empty-state" style="color:#ef4444;">Error: ${error.message}</div>
      `;
    }
  }

  // ============ INIT ============
  document.addEventListener('DOMContentLoaded', function() {
    initCharts();
    loadSystemInfo();
    // Auto refresh every 5 seconds
    setInterval(loadSystemInfo, 5000);
  });
</script>
