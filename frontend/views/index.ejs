<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Rye Panel' %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0f0f1a;
            color: #e0e0e0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
        }
        .container {
            text-align: center;
            padding: 40px;
            background: #1a1a2e;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.8);
            max-width: 500px;
            width: 100%;
        }
        .logo {
            font-size: 48px;
            margin-bottom: 10px;
        }
        h1 {
            font-size: 28px;
            font-weight: 700;
            background: linear-gradient(135deg, #a855f7, #6366f1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
        }
        .subtitle {
            color: #94a3b8;
            font-size: 14px;
            margin-bottom: 24px;
        }
        .status {
            display: inline-block;
            background: #22c55e;
            color: #fff;
            padding: 4px 16px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 20px;
        }
        .login-box {
            background: #16213e;
            padding: 20px;
            border-radius: 12px;
            text-align: left;
        }
        .login-box label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #94a3b8;
            margin-bottom: 4px;
        }
        .login-box input {
            width: 100%;
            padding: 10px 14px;
            margin-bottom: 12px;
            border: 1px solid #334155;
            border-radius: 8px;
            background: #0f172a;
            color: #e2e8f0;
            font-size: 14px;
            outline: none;
            transition: 0.2s;
        }
        .login-box input:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.3);
        }
        .login-box button {
            width: 100%;
            padding: 10px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(135deg, #8b5cf6, #6366f1);
            color: #fff;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }
        .login-box button:hover {
            transform: scale(1.02);
            opacity: 0.9;
        }
        .footer {
            margin-top: 16px;
            font-size: 12px;
            color: #475569;
        }
        .footer a {
            color: #8b5cf6;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">🚀</div>
        <h1>Rye Panel</h1>
        <p class="subtitle">Multi WhatsApp Bot Management</p>
        <span class="status">● Live</span>

        <div class="login-box">
            <form id="loginForm" action="/login" method="POST">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" placeholder="admin" value="admin" required>

                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="••••••••" value="admin123" required>

                <button type="submit">Masuk ke Dashboard</button>
            </form>
        </div>

        <p class="footer">
            Built by <a href="https://github.com/ryenzz211" target="_blank">Ryenz</a> · v1.0
        </p>
    </div>

    <script>
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;

            fetch('/api/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            })
            .then(res => res.json())
            .then(data => {
                if (data.token) {
                    localStorage.setItem('token', data.token);
                    window.location.href = '/dashboard';
                } else {
                    alert('Login gagal: ' + (data.message || 'Unknown error'));
                }
            })
            .catch(err => alert('Error: ' + err.message));
        });
    </script>
</body>
</html>
