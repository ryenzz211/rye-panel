<%- include('../partials/header.ejs', { user: user }) %>

<div class="audit-container">
  <div class="audit-header">
    <div>
      <h2><i class="fas fa-history"></i> Audit Logs</h2>
      <p>Riwayat aktivitas admin panel</p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <button onclick="refreshLogs()" class="btn btn-secondary">
        <i class="fas fa-sync"></i> Refresh
      </button>
      <button onclick="clearOldLogs()" class="btn btn-warning">
        <i class="fas fa-clock"></i> Clear Old (30d)
      </button>
      <button onclick="deleteAllLogs()" class="btn btn-danger">
        <i class="fas fa-trash"></i> Delete All
      </button>
    </div>
  </div>

  <div class="audit-filters">
    <input type="text" id="searchFilter" placeholder="🔍 Search logs..." oninput="filterLogs()">
    <select id="statusFilter" onchange="filterLogs()">
      <option value="all">All Status</option>
      <option value="success">✅ Success</option>
      <option value="failed">❌ Failed</option>
    </select>
  </div>

  <div id="auditList" class="audit-list">
    <div class="loading">Loading audit logs...</div>
  </div>
</div>

<%- include('../partials/sidebar.ejs', { user: user, currentPath: currentPath }) %>

<style>
  .audit-container {
    padding: 20px;
    max-width: 1200px;
    margin: 60px auto 0 0;
  }

  .audit-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 15px;
  }

  .audit-header h2 {
    font-size: 1.5rem;
    margin: 0;
  }

  .audit-header h2 i {
    color: #6c63ff;
  }

  .audit-header p {
    color: var(--text-secondary, #888);
    margin: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 10px;
    border: none;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-secondary {
    background: rgba(255,255,255,0.08);
    color: var(--text-color, #fff);
  }
  .btn-secondary:hover { background: rgba(255,255,255,0.15); }

  .btn-warning {
    background: #f59e0b;
    color: #fff;
  }
  .btn-warning:hover { background: #d97706; }

  .btn-danger {
    background: #ef4444;
    color: #fff;
  }
  .btn-danger:hover { background: #dc2626; }

  .btn-sm {
    padding: 4px 10px;
    font-size: 0.7rem;
    border-radius: 6px;
  }

  .audit-filters {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .audit-filters input,
  .audit-filters select {
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid var(--border-color, rgba(255,255,255,0.1));
    background: var(--bg-input, rgba(255,255,255,0.05));
    color: var(--text-color, #fff);
    font-size: 0.9rem;
    flex: 1;
    min-width: 200px;
  }

  .audit-filters input:focus,
  .audit-filters select:focus {
    outline: none;
    border-color: #6c63ff;
  }

  .audit-filters select option {
    background: #1a1a2e;
    color: #fff;
  }

  .audit-list {
    background: var(--bg-card, rgba(255,255,255,0.04));
    border-radius: 12px;
    border: 1px solid var(--border-color, rgba(255,255,255,0.06));
    overflow: hidden;
    min-height: 200px;
  }

  .audit-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 18px;
    border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.04));
    transition: background 0.2s;
  }

  .audit-item:hover {
    background: rgba(255,255,255,0.02);
  }

  .audit-item .audit-info {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }

  .audit-item .audit-icon {
    font-size: 1.2rem;
    width: 32px;
    text-align: center;
  }

  .audit-item .audit-icon.success { color: #22c55e; }
  .audit-item .audit-icon.failed { color: #ef4444; }
  .audit-item .audit-icon.info { color: #60a5fa; }

  .audit-item .audit-details {
    flex: 1;
    min-width: 0;
  }

  .audit-item .audit-action {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-color, #fff);
  }

  .audit-item .audit-target {
    font-size: 0.8rem;
    color: var(--text-secondary, #888);
    font-family: monospace;
  }

  .audit-item .audit-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .audit-item .audit-time {
    font-size: 0.75rem;
    color: var(--text-secondary, #888);
  }

  .audit-item .audit-status {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 12px;
    border-radius: 20px;
    display: inline-block;
  }

  .audit-item .audit-status.success {
    background: rgba(34,197,94,0.15);
    color: #22c55e;
  }

  .audit-item .audit-status.failed {
    background: rgba(239,68,68,0.15);
    color: #ef4444;
  }

  .audit-item .audit-delete {
    background: none;
    border: none;
    color: #666;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
    transition: all 0.2s;
    font-size: 0.8rem;
  }

  .audit-item .audit-delete:hover {
    background: rgba(239,68,68,0.15);
    color: #ef4444;
  }

  .loading {
    text-align: center;
    padding: 40px;
    color: var(--text-secondary, #888);
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-secondary, #888);
  }

  .empty-state i {
    font-size: 3rem;
    color: #6c63ff;
    margin-bottom: 10px;
  }

  @media (min-width: 1024px) {
    .audit-container { margin-left: 0; }
  }

  @media (max-width: 768px) {
    .audit-container { padding: 10px; margin: 60px 10px 0; }
    .audit-item { flex-direction: column; align-items: stretch; gap: 8px; }
    .audit-item .audit-meta { justify-content: flex-start; }
    .audit-filters { flex-direction: column; }
    .audit-filters input { min-width: 100%; }
  }
</style>

<script>
  let allLogs = [];

  // ============ LOAD ============
  async function loadAuditLogs() {
    try {
      const res = await fetch('/api/audit?limit=100');
      const data = await res.json();

      const container = document.getElementById('auditList');

      if (!data.success) {
        container.innerHTML = `<div class="empty-state" style="color:#ef4444;">Error: ${data.message}</div>`;
        return;
      }

      allLogs = data.data || [];

      if (allLogs.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <i class="fas fa-history"></i>
            <p>Belum ada aktivitas</p>
          </div>
        `;
        return;
      }

      renderLogs(allLogs);
    } catch (error) {
      document.getElementById('auditList').innerHTML = `
        <div class="empty-state" style="color:#ef4444;">Error: ${error.message}</div>
      `;
    }
  }

  // ============ RENDER ============
  function renderLogs(logs) {
    const container = document.getElementById('auditList');
    
    if (!logs || logs.length === 0) {
      container.innerHTML = `
        <div class="empty-state">
          <i class="fas fa-history"></i>
          <p>Tidak ada log yang cocok</p>
        </div>
      `;
      return;
    }

    let html = '';
    const actionMap = {
      'LOGIN': '🔑 Login',
      'LOGOUT': '🚪 Logout',
      'BOT_START': '▶️ Start Bot',
      'BOT_STOP': '⏹️ Stop Bot',
      'BOT_RESTART': '🔄 Restart Bot',
      'BOT_CREATE': '📦 Create Bot',
      'BOT_IMPORT': '📥 Import Bot',
      'BOT_DELETE': '🗑️ Delete Bot',
      'BOT_UPDATE': '✏️ Update Bot',
      'USER_CREATE': '👤 New User',
      'USER_UPDATE': '✏️ Update User',
      'USER_DELETE': '🗑️ Delete User'
    };

    for (const log of logs) {
      const time = new Date(log.timestamp * 1000).toLocaleString('id-ID');
      const status = log.status || 'success';
      const icon = status === 'success' ? '✅' : '❌';
      const iconClass = status === 'success' ? 'success' : 'failed';
      const actionLabel = actionMap[log.action] || log.action || 'Unknown';

      html += `
        <div class="audit-item">
          <div class="audit-info">
            <span class="audit-icon ${iconClass}">${icon}</span>
            <div class="audit-details">
              <div class="audit-action">${actionLabel}</div>
              <div class="audit-target">${log.target || '-'}</div>
              ${log.details ? `<div style="font-size:0.75rem;color:#666;">${log.details}</div>` : ''}
            </div>
          </div>
          <div class="audit-meta">
            <div class="audit-time">${time}</div>
            <span class="audit-status ${status}">${status.toUpperCase()}</span>
            <button class="audit-delete" onclick="deleteLog(${log.id})" title="Delete">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </div>
      `;
    }

    container.innerHTML = html;
  }

  // ============ FILTER ============
  function filterLogs() {
    const search = document.getElementById('searchFilter').value.toLowerCase();
    const status = document.getElementById('statusFilter').value;

    let filtered = allLogs;

    if (search) {
      filtered = filtered.filter(log => 
        (log.action || '').toLowerCase().includes(search) ||
        (log.target || '').toLowerCase().includes(search) ||
        (log.details || '').toLowerCase().includes(search)
      );
    }

    if (status !== 'all') {
      filtered = filtered.filter(log => (log.status || 'success') === status);
    }

    renderLogs(filtered);
  }

  // ============ REFRESH ============
  function refreshLogs() {
    document.getElementById('auditList').innerHTML = '<div class="loading">Loading...</div>';
    loadAuditLogs();
  }

  // ============ DELETE SINGLE ============
  async function deleteLog(id) {
    if (!confirm('Hapus audit log ini?')) return;

    try {
      const res = await fetch(`/api/audit/${id}`, { method: 'DELETE' });
      const data = await res.json();

      if (data.success) {
        alert('✅ Audit log dihapus!');
        refreshLogs();
      } else {
        alert('❌ ' + data.message);
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  // ============ CLEAR OLD ============
  async function clearOldLogs() {
    if (!confirm('Hapus audit logs lebih dari 30 hari?')) return;

    try {
      const res = await fetch('/api/audit/clear', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ days: 30 })
      });

      const data = await res.json();

      if (data.success) {
        alert('✅ Audit logs cleared!');
        refreshLogs();
      } else {
        alert('❌ ' + data.message);
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  // ============ DELETE ALL ============
  async function deleteAllLogs() {
    if (!confirm('⚠️ Hapus SEMUA audit logs?\n\nTindakan ini tidak dapat dibatalkan!')) return;

    try {
      const res = await fetch('/api/audit/all', { method: 'DELETE' });
      const data = await res.json();

      if (data.success) {
        alert('✅ Semua audit logs dihapus!');
        refreshLogs();
      } else {
        alert('❌ ' + data.message);
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  // ============ INIT ============
  loadAuditLogs();
  setInterval(refreshLogs, 10000);
</script>
