<%- include('../partials/header.ejs', { user: user }) %>

<div class="users-container">
  <div class="users-header">
    <div>
      <h2><i class="fas fa-users"></i> Users</h2>
      <p>Kelola user panel</p>
    </div>
    <button onclick="showCreateUser()" class="btn btn-primary">
      <i class="fas fa-plus"></i> Add User
    </button>
  </div>

  <div id="usersList" class="users-list">
    <div class="loading">Loading users...</div>
  </div>
</div>

<!-- Create/Edit User Modal -->
<div class="user-modal" id="userModal">
  <div class="user-modal-content">
    <div class="user-modal-header">
      <h3 id="modalTitle">Add User</h3>
      <button class="user-modal-close" onclick="closeUserModal()">✕</button>
    </div>
    <div class="user-modal-body">
      <div id="userForm">
        <div class="form-group">
          <label>Username</label>
          <input type="text" id="userUsername" placeholder="username">
        </div>
        <div class="form-group">
          <label>Display Name</label>
          <input type="text" id="userDisplayName" placeholder="Display Name">
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" id="userEmail" placeholder="user@example.com">
        </div>
        <div class="form-group" id="passwordGroup">
          <label>Password</label>
          <input type="password" id="userPassword" placeholder="Minimal 6 karakter">
        </div>
        <div class="form-group">
          <label>Role</label>
          <select id="userRole">
            <option value="user">User</option>
            <option value="admin">Admin</option>
          </select>
        </div>
      </div>
    </div>
    <div class="user-modal-footer">
      <button onclick="closeUserModal()" class="btn btn-secondary">Cancel</button>
      <button onclick="saveUser()" class="btn btn-primary">💾 Save</button>
    </div>
  </div>
</div>

<%- include('../partials/sidebar.ejs', { user: user, currentPath: currentPath }) %>

<style>
  .users-container {
    padding: 20px;
    max-width: 1000px;
    margin: 60px auto 0 0;
  }

  .users-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 15px;
  }

  .users-header h2 {
    font-size: 1.5rem;
    margin: 0;
  }

  .users-header h2 i {
    color: #6c63ff;
  }

  .users-header p {
    color: var(--text-secondary, #888);
    margin: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 10px;
    border: none;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background: #6c63ff;
    color: #fff;
  }

  .btn-primary:hover {
    background: #5a52e0;
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: rgba(255,255,255,0.08);
    color: var(--text-color, #fff);
  }

  .btn-secondary:hover {
    background: rgba(255,255,255,0.15);
  }

  .btn-danger {
    background: #ef4444;
    color: #fff;
  }

  .btn-danger:hover {
    background: #dc2626;
  }

  .btn-sm {
    padding: 6px 14px;
    font-size: 0.8rem;
    border-radius: 8px;
  }

  .users-list {
    background: var(--bg-card, rgba(255,255,255,0.04));
    border-radius: 12px;
    border: 1px solid var(--border-color, rgba(255,255,255,0.06));
    overflow: hidden;
    min-height: 200px;
  }

  .user-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.04));
  }

  .user-item:hover {
    background: rgba(255,255,255,0.02);
  }

  .user-item .user-info {
    display: flex;
    align-items: center;
    gap: 14px;
    flex: 1;
  }

  .user-item .user-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(108,99,255,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: #6c63ff;
    font-size: 1rem;
  }

  .user-item .user-details {
    flex: 1;
  }

  .user-item .user-name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-color, #fff);
  }

  .user-item .user-username {
    font-size: 0.8rem;
    color: var(--text-secondary, #888);
  }

  .user-item .user-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .user-item .user-role {
    font-size: 0.65rem;
    font-weight: 600;
    padding: 2px 12px;
    border-radius: 20px;
    text-transform: uppercase;
  }

  .user-item .user-role.admin {
    background: rgba(108,99,255,0.15);
    color: #6c63ff;
  }

  .user-item .user-role.user {
    background: rgba(34,197,94,0.15);
    color: #22c55e;
  }

  .user-item .user-status {
    font-size: 0.65rem;
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 20px;
  }

  .user-item .user-status.active {
    background: rgba(34,197,94,0.15);
    color: #22c55e;
  }

  .user-item .user-status.inactive {
    background: rgba(239,68,68,0.15);
    color: #ef4444;
  }

  .user-item .user-actions {
    display: flex;
    gap: 6px;
  }

  .user-item .user-actions button {
    background: none;
    border: none;
    color: #666;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
    transition: all 0.2s;
    font-size: 0.8rem;
  }

  .user-item .user-actions button:hover {
    background: rgba(255,255,255,0.08);
    color: #fff;
  }

  .user-item .user-actions button.danger:hover {
    background: rgba(239,68,68,0.2);
    color: #ef4444;
  }

  .loading {
    text-align: center;
    padding: 40px;
    color: var(--text-secondary, #888);
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-secondary, #888);
  }

  .empty-state i {
    font-size: 3rem;
    color: #6c63ff;
    margin-bottom: 10px;
  }

  /* Modal */
  .user-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(8px);
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }

  .user-modal.active {
    display: flex;
  }

  .user-modal-content {
    background: var(--bg-card, #1a1a2e);
    border-radius: 20px;
    width: 90%;
    max-width: 450px;
    border: 1px solid var(--border-color, rgba(108,99,255,0.15));
    overflow: hidden;
  }

  .user-modal-header {
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.06));
  }

  .user-modal-header h3 {
    margin: 0;
    font-size: 1rem;
  }

  .user-modal-close {
    background: none;
    border: none;
    color: #888;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 4px 10px;
    border-radius: 8px;
  }

  .user-modal-close:hover {
    background: rgba(255,255,255,0.1);
    color: #fff;
  }

  .user-modal-body {
    padding: 20px;
  }

  .form-group {
    margin-bottom: 14px;
  }

  .form-group label {
    display: block;
    font-weight: 500;
    font-size: 0.85rem;
    margin-bottom: 4px;
    color: var(--text-secondary, #aaa);
  }

  .form-group input,
  .form-group select {
    width: 100%;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid var(--border-color, rgba(255,255,255,0.1));
    background: var(--bg-input, rgba(255,255,255,0.05));
    color: var(--text-color, #fff);
    font-size: 0.95rem;
  }

  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: #6c63ff;
  }

  .form-group select option {
    background: #1a1a2e;
    color: #fff;
  }

  .user-modal-footer {
    padding: 12px 20px;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    border-top: 1px solid var(--border-color, rgba(255,255,255,0.06));
  }

  @media (min-width: 1024px) {
    .users-container { margin-left: 0; }
  }

  @media (max-width: 768px) {
    .users-container { padding: 10px; margin: 60px 10px 0; }
    .user-item { flex-direction: column; align-items: stretch; gap: 8px; }
    .user-item .user-meta { justify-content: flex-start; }
    .user-modal-content { width: 95%; }
  }
</style>

<script>
  let editingUserId = null;

  async function loadUsers() {
    try {
      const res = await fetch('/api/users');
      const data = await res.json();

      const container = document.getElementById('usersList');

      if (!data.success) {
        container.innerHTML = `<div class="empty-state" style="color:#ef4444;">Error: ${data.message}</div>`;
        return;
      }

      const users = data.data || [];

      if (users.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <i class="fas fa-users"></i>
            <p>Belum ada user</p>
            <button onclick="showCreateUser()" class="btn btn-primary" style="margin-top:10px;">
              <i class="fas fa-plus"></i> Add User
            </button>
          </div>
        `;
        return;
      }

      let html = '';
      for (const user of users) {
        const initial = (user.display_name || user.username).charAt(0).toUpperCase();
        const roleClass = user.role === 'admin' ? 'admin' : 'user';
        const statusClass = user.status === 'active' ? 'active' : 'inactive';

        html += `
          <div class="user-item">
            <div class="user-info">
              <div class="user-avatar">${initial}</div>
              <div class="user-details">
                <div class="user-name">${user.display_name || user.username}</div>
                <div class="user-username">@${user.username}</div>
              </div>
            </div>
            <div class="user-meta">
              <span class="user-role ${roleClass}">${user.role}</span>
              <span class="user-status ${statusClass}">${user.status || 'active'}</span>
              <span style="font-size:0.7rem;color:#666;">${user.email || '-'}</span>
            </div>
            <div class="user-actions">
              <button onclick="editUser('${user.id}')" title="Edit">✏️</button>
              <button class="danger" onclick="deleteUser('${user.id}','${user.username}')" title="Delete">🗑️</button>
            </div>
          </div>
        `;
      }

      container.innerHTML = html;
    } catch (error) {
      document.getElementById('usersList').innerHTML = `
        <div class="empty-state" style="color:#ef4444;">Error: ${error.message}</div>
      `;
    }
  }

  function showCreateUser() {
    editingUserId = null;
    document.getElementById('modalTitle').textContent = '➕ Add User';
    document.getElementById('userUsername').value = '';
    document.getElementById('userDisplayName').value = '';
    document.getElementById('userEmail').value = '';
    document.getElementById('userPassword').value = '';
    document.getElementById('userRole').value = 'user';
    document.getElementById('passwordGroup').style.display = 'block';
    document.getElementById('userModal').classList.add('active');
  }

  function editUser(id) {
    editingUserId = id;
    document.getElementById('modalTitle').textContent = '✏️ Edit User';
    document.getElementById('passwordGroup').style.display = 'none';
    
    fetch(`/api/users/${id}`)
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          const user = data.data;
          document.getElementById('userUsername').value = user.username;
          document.getElementById('userUsername').disabled = true;
          document.getElementById('userDisplayName').value = user.display_name || '';
          document.getElementById('userEmail').value = user.email || '';
          document.getElementById('userRole').value = user.role || 'user';
          document.getElementById('userModal').classList.add('active');
        }
      });
  }

  function closeUserModal() {
    document.getElementById('userModal').classList.remove('active');
    document.getElementById('userUsername').disabled = false;
    editingUserId = null;
  }

  async function saveUser() {
    const username = document.getElementById('userUsername').value.trim();
    const display_name = document.getElementById('userDisplayName').value.trim();
    const email = document.getElementById('userEmail').value.trim();
    const password = document.getElementById('userPassword').value;
    const role = document.getElementById('userRole').value;

    if (!username) {
      alert('Username wajib diisi!');
      return;
    }

    const data = { username, display_name, email, role };
    
    if (editingUserId) {
      // Update
      const res = await fetch(`/api/users/${editingUserId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        alert('✅ User updated!');
        closeUserModal();
        loadUsers();
      } else {
        alert('❌ ' + result.message);
      }
    } else {
      // Create
      if (!password || password.length < 6) {
        alert('Password minimal 6 karakter!');
        return;
      }
      data.password = password;
      
      const res = await fetch('/api/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        alert('✅ User created!');
        closeUserModal();
        loadUsers();
      } else {
        alert('❌ ' + result.message);
      }
    }
  }

  async function deleteUser(id, username) {
    if (!confirm(`Hapus user "${username}"?`)) return;
    
    try {
      const res = await fetch(`/api/users/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        alert('✅ User deleted!');
        loadUsers();
      } else {
        alert('❌ ' + data.message);
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  // Click outside to close modal
  document.getElementById('userModal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('userModal')) {
      closeUserModal();
    }
  });

  // ESC key to close
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeUserModal();
    }
  });

  // Load on page load
  loadUsers();
</script>
