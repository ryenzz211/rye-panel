<%- include('../partials/header.ejs', { user: user }) %>

<div class="env-container">
  <div class="env-header">
    <div>
      <h2><i class="fas fa-key"></i> Environment Variables</h2>
      <p id="botName" style="color:#888;font-size:0.85rem;">Loading...</p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <button onclick="addVariable()" class="btn btn-sm btn-primary">
        <i class="fas fa-plus"></i> Add Variable
      </button>
      <button onclick="importEnv()" class="btn btn-sm btn-secondary">
        <i class="fas fa-file-import"></i> Import .env
      </button>
      <button onclick="exportEnv()" class="btn btn-sm btn-secondary">
        <i class="fas fa-file-export"></i> Export .env
      </button>
      <button onclick="window.location.href='/bots'" class="btn btn-sm btn-secondary">
        <i class="fas fa-arrow-left"></i> Back
      </button>
    </div>
  </div>

  <div id="envList" class="env-list">
    <div class="loading">Loading environment variables...</div>
  </div>
</div>

<%- include('../partials/sidebar.ejs', { user: user }) %>

<style>
  .env-container {
    padding: 20px;
    max-width: 1000px;
    margin: 60px auto 0 0;
  }
  .env-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    flex-wrap: wrap;
    gap: 10px;
    background: rgba(255,255,255,0.03);
    padding: 15px 20px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.06);
  }
  .env-header h2 { margin: 0; font-size: 1.2rem; }
  .env-header h2 i { color: #6c63ff; }
  .btn-sm {
    padding: 6px 14px;
    font-size: 0.8rem;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .btn-primary { background: #6c63ff; color: #fff; }
  .btn-primary:hover { background: #5a52e0; }
  .btn-secondary { background: rgba(255,255,255,0.08); color: #fff; }
  .btn-secondary:hover { background: rgba(255,255,255,0.15); }
  .env-list {
    background: rgba(255,255,255,0.03);
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.06);
    overflow: hidden;
    min-height: 200px;
  }
  .env-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .env-item:hover { background: rgba(255,255,255,0.03); }
  .env-item .env-info {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
  }
  .env-item .env-key {
    font-weight: 600;
    font-size: 0.9rem;
    color: #fbbf24;
    min-width: 150px;
  }
  .env-item .env-value {
    color: #60a5fa;
    font-size: 0.85rem;
    font-family: monospace;
    word-break: break-all;
  }
  .env-item .env-actions {
    display: flex;
    gap: 6px;
  }
  .env-item .env-actions button {
    background: none;
    border: none;
    color: #666;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
    transition: all 0.2s;
    font-size: 0.8rem;
  }
  .env-item .env-actions button:hover { background: rgba(255,255,255,0.08); color: #fff; }
  .env-item .env-actions button.danger:hover { background: rgba(239,68,68,0.2); color: #ef4444; }
  .empty-state { text-align: center; padding: 60px 20px; color: #666; }
  .empty-state i { font-size: 3rem; color: #6c63ff; margin-bottom: 10px; }
  .loading { text-align: center; padding: 40px; color: #888; }

  .env-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(8px);
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }
  .env-modal.active { display: flex; }
  .env-modal-content {
    background: #1a1a2e;
    border-radius: 20px;
    width: 90%;
    max-width: 500px;
    border: 1px solid rgba(108,99,255,0.15);
    overflow: hidden;
  }
  .env-modal-header {
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .env-modal-header h3 { margin: 0; font-size: 1rem; }
  .env-modal-close {
    background: none;
    border: none;
    color: #888;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 4px 10px;
    border-radius: 8px;
  }
  .env-modal-close:hover { background: rgba(255,255,255,0.1); color: #fff; }
  .env-modal-body { padding: 20px; }
  .env-modal-body label {
    display: block;
    font-weight: 500;
    font-size: 0.9rem;
    margin-bottom: 5px;
    color: #ccc;
  }
  .env-modal-body input, .env-modal-body textarea {
    width: 100%;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05);
    color: #fff;
    font-size: 0.95rem;
    margin-bottom: 12px;
    font-family: 'Courier New', monospace;
  }
  .env-modal-body input:focus, .env-modal-body textarea:focus {
    outline: none;
    border-color: #6c63ff;
  }
  .env-modal-body textarea { min-height: 200px; resize: vertical; }
  .env-modal-footer {
    padding: 12px 20px;
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  @media (max-width: 768px) {
    .env-container { margin: 60px 10px 0 10px; padding: 10px; }
    .env-header { flex-direction: column; align-items: stretch; }
    .env-item { flex-wrap: wrap; gap: 8px; }
    .env-item .env-actions { width: 100%; justify-content: flex-end; }
    .env-item .env-key { min-width: 100px; }
  }
</style>

<script>
  const botId = '<%= botId %>';

  async function loadEnv() {
    try {
      console.log('[Env] Loading for bot:', botId);
      const res = await fetch(`/api/env/${botId}`);
      const data = await res.json();
      console.log('[Env] Response:', data);

      const container = document.getElementById('envList');

      if (!data.success) {
        container.innerHTML = `<div class="empty-state" style="color:#ef4444;">Error: ${data.message}</div>`;
        return;
      }

      const result = data.data;
      document.getElementById('botName').textContent = 'Bot: ' + (result.botName || 'Unknown');

      const vars = result.variables || {};
      const keys = Object.keys(vars);

      if (keys.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <i class="fas fa-key"></i>
            <p>Belum ada environment variables</p>
            <button onclick="addVariable()" class="btn btn-sm btn-primary" style="margin-top:10px;">
              <i class="fas fa-plus"></i> Tambah Variable
            </button>
          </div>
        `;
        return;
      }

      let html = '';
      for (const key of keys) {
        const value = vars[key];
        const displayValue = value && value.length > 50 ? value.substring(0, 50) + '...' : value || '';
        html += `
          <div class="env-item">
            <div class="env-info">
              <span class="env-key">${escapeHtml(key)}</span>
              <span class="env-value">${escapeHtml(displayValue)}</span>
            </div>
            <div class="env-actions">
              <button onclick="editVariable('${escapeHtml(key)}')" title="Edit">✏️</button>
              <button class="danger" onclick="deleteVariable('${escapeHtml(key)}')" title="Delete">🗑️</button>
            </div>
          </div>
        `;
      }

      container.innerHTML = html;
    } catch (error) {
      console.error('[Env] Load error:', error);
      document.getElementById('envList').innerHTML = `
        <div class="empty-state" style="color:#ef4444;">Error: ${error.message}</div>
      `;
    }
  }

  function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Add Variable
  function addVariable() {
    document.getElementById('modalTitle').textContent = '➕ Add Variable';
    document.getElementById('envKey').value = '';
    document.getElementById('envKey').disabled = false;
    document.getElementById('envValue').value = '';
    document.getElementById('envTextarea').style.display = 'none';
    document.getElementById('envForm').style.display = 'block';
    document.getElementById('saveBtn').style.display = 'inline-flex';
    document.getElementById('importBtn').style.display = 'none';
    document.getElementById('envModal').classList.add('active');
    setTimeout(() => document.getElementById('envKey').focus(), 100);
  }

  // Edit Variable
  function editVariable(key) {
    document.getElementById('modalTitle').textContent = '✏️ Edit Variable';
    document.getElementById('envKey').value = key;
    document.getElementById('envKey').disabled = true;
    document.getElementById('envTextarea').style.display = 'none';
    document.getElementById('envForm').style.display = 'block';
    document.getElementById('saveBtn').style.display = 'inline-flex';
    document.getElementById('importBtn').style.display = 'none';
    
    // Fetch current value
    fetch(`/api/env/${botId}`)
      .then(r => r.json())
      .then(data => {
        if (data.success && data.data.variables && data.data.variables[key]) {
          document.getElementById('envValue').value = data.data.variables[key];
        }
        document.getElementById('envModal').classList.add('active');
        setTimeout(() => document.getElementById('envValue').focus(), 100);
      })
      .catch(err => {
        alert('Error: ' + err.message);
      });
  }

  // Import .env
  function importEnv() {
    document.getElementById('modalTitle').textContent = '📥 Import .env';
    document.getElementById('envTextarea').style.display = 'block';
    document.getElementById('envForm').style.display = 'none';
    document.getElementById('saveBtn').style.display = 'none';
    document.getElementById('importBtn').style.display = 'inline-flex';
    document.getElementById('envTextarea').value = '';
    document.getElementById('envModal').classList.add('active');
    setTimeout(() => document.getElementById('envTextarea').focus(), 100);
  }

  // Export .env
  async function exportEnv() {
    try {
      const res = await fetch(`/api/env/${botId}/export`);
      const data = await res.json();
      if (data.success) {
        const blob = new Blob([data.data], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = '.env';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      } else {
        alert('❌ ' + data.message);
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  // Close modal
  function closeEnvModal() {
    document.getElementById('envModal').classList.remove('active');
    document.getElementById('envKey').disabled = false;
  }

  // Save variable
  async function saveVariable() {
    const key = document.getElementById('envKey').value.trim();
    const value = document.getElementById('envValue').value.trim();

    if (!key) {
      alert('Key wajib diisi!');
      return;
    }

    try {
      const res = await fetch(`/api/env/${botId}/var`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key, value })
      });

      const data = await res.json();
      if (data.success) {
        closeEnvModal();
        loadEnv();
      } else {
        alert('❌ ' + data.message);
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  // Import .env text
  async function saveImport() {
    const text = document.getElementById('envTextarea').value;

    if (!text.trim()) {
      alert('Masukkan .env content!');
      return;
    }

    try {
      const res = await fetch(`/api/env/${botId}/import`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ envText: text })
      });

      const data = await res.json();
      if (data.success) {
        closeEnvModal();
        loadEnv();
      } else {
        alert('❌ ' + data.message);
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  // Delete variable
  async function deleteVariable(key) {
    if (!confirm(`Hapus variable "${key}"?`)) return;

    try {
      const res = await fetch(`/api/env/${botId}/var`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ key })
      });

      const data = await res.json();
      if (data.success) {
        loadEnv();
      } else {
        alert('❌ ' + data.message);
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  // Click outside to close modal
  document.getElementById('envModal').addEventListener('click', (e) => {
    if (e.target === document.getElementById('envModal')) {
      closeEnvModal();
    }
  });

  // ESC to close modal
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeEnvModal();
    }
  });

  // Load on page load
  loadEnv();
</script>

<!-- Modal -->
<div class="env-modal" id="envModal">
  <div class="env-modal-content">
    <div class="env-modal-header">
      <h3 id="modalTitle">Add Variable</h3>
      <button class="env-modal-close" onclick="closeEnvModal()">✕</button>
    </div>
    <div class="env-modal-body">
      <div id="envForm">
        <label>Key</label>
        <input type="text" id="envKey" placeholder="API_KEY" style="font-family:monospace;text-transform:uppercase;">
        <label>Value</label>
        <input type="text" id="envValue" placeholder="your-api-key-here" style="font-family:monospace;">
      </div>
      <textarea id="envTextarea" style="display:none;" placeholder="# .env format&#10;API_KEY=value&#10;SECRET=token"></textarea>
    </div>
    <div class="env-modal-footer">
      <button onclick="closeEnvModal()" class="btn btn-sm btn-secondary">Cancel</button>
      <button onclick="saveVariable()" id="saveBtn" class="btn btn-sm btn-primary">💾 Save</button>
      <button onclick="saveImport()" id="importBtn" class="btn btn-sm btn-primary" style="display:none;">📥 Import</button>
    </div>
  </div>
</div>
