<%- include('../partials/header.ejs') %>

<div class="create-container">
  <div class="create-card">
    <h1><i class="fas fa-plus-circle"></i> Buat Bot Baru</h1>
    <p>Masukkan informasi bot yang ingin dibuat</p>

    <form id="createForm">
      <div class="form-group">
        <label>Nama Bot *</label>
        <input type="text" id="name" placeholder="My WhatsApp Bot" required>
      </div>

      <div class="form-group">
        <label>Nama Tampilan</label>
        <input type="text" id="display_name" placeholder="My Bot">
      </div>

      <div class="form-group">
        <label>Entry File</label>
        <input type="text" id="entry_file" value="index.js">
      </div>

      <div class="form-group">
        <label>Prefix</label>
        <input type="text" id="prefix" value=".">
      </div>

      <div class="form-group">
        <label>Nomor WhatsApp</label>
        <input type="text" id="phone_number" placeholder="628xxxxxxxxxx">
      </div>

      <div class="form-actions">
        <a href="/bots" class="btn btn-secondary">Batal</a>
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-plus"></i> Buat Bot
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/sidebar.ejs') %>

<style>
  .create-container {
    padding: 20px;
    max-width: 600px;
    margin: 80px auto 0;
  }

  .create-card {
    background: rgba(255,255,255,0.04);
    border-radius: 20px;
    padding: 30px;
    border: 1px solid rgba(255,255,255,0.06);
  }

  .create-card h1 {
    font-size: 1.5rem;
    margin-bottom: 5px;
  }

  .create-card p {
    color: #888;
    margin-bottom: 25px;
  }

  .form-group {
    margin-bottom: 18px;
  }

  .form-group label {
    display: block;
    font-weight: 500;
    font-size: 0.9rem;
    margin-bottom: 5px;
  }

  .form-group input {
    width: 100%;
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05);
    color: #fff;
    font-size: 0.95rem;
    transition: border-color 0.3s;
  }

  .form-group input:focus {
    outline: none;
    border-color: #6c63ff;
  }

  .form-actions {
    display: flex;
    gap: 12px;
    margin-top: 20px;
  }

  .form-actions .btn {
    flex: 1;
    justify-content: center;
  }

  .btn-secondary {
    background: rgba(255,255,255,0.08);
    color: #fff;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .create-container {
      margin: 70px 15px 0;
      padding: 10px;
    }
    .create-card {
      padding: 20px;
    }
    .form-actions {
      flex-direction: column;
    }
  }
</style>

<script>
  document.getElementById('createForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const data = {
      name: document.getElementById('name').value,
      display_name: document.getElementById('display_name').value,
      entry_file: document.getElementById('entry_file').value,
      prefix: document.getElementById('prefix').value,
      phone_number: document.getElementById('phone_number').value
    };

    try {
      const res = await fetch('/api/bots', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await res.json();

      if (result.success) {
        alert('✅ Bot berhasil dibuat!');
        window.location.href = '/bots';
      } else {
        alert('❌ ' + result.message);
      }
    } catch (error) {
      alert('❌ Terjadi kesalahan: ' + error.message);
    }
  });
</script>
