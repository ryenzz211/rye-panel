# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Session
SESSION_SECRET=rye-panel-secret-key-2026
SESSION_MAX_AGE=604800000

# Database
DB_PATH=./data/database/rye.db

# Security
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# File Upload
MAX_ZIP_SIZE=52428800
MAX_FILE_COUNT=1000
MAX_EXTRACTED_SIZE=209715200

# Logging
LOG_LEVEL=info
LOG_RETENTION_DAYS=7

# WhatsApp
PAIRING_TIMEOUT=120000
CONNECTION_TIMEOUT=60000
RECONNECT_DELAY=5000

# Bot
DEFAULT_RESTART_DELAY=5
DEFAULT_MAX_RESTART=5
AUTO_RESTART=true

# Built-in Bot
BUILTIN_BOT_ENABLED=true
BUILTIN_BOT_NAME=RyeBot
BUILTIN_BOT_PREFIX=.
